{
  "name": "glassbox-trace",
  "version": "0.9.0",
  "description": "Other tools show what happened in a Claude Code session; Glassbox tells you what went wrong. Timeline, token and cost burn, auto-diagnostics with evidence and advice, session compare, live tail, a fleet view, a secrets scanner for transcripts (fence), a CLAUDE.md compliance report (adhere), a CLI and a Claude Code Stop hook that feeds the findings back to the agent.",
  "main": "src/trace-core.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "sanitize": "node scripts/sanitize.mjs",
    "e2e": "node test/browser.e2e.mjs",
    "check": "npm test && npm run build && npm run e2e",
    "audit": "node test/audit.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "license": "MIT",
  "author": "Aldo Hushi",
  "bin": {
    "glassbox": "bin/glassbox.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist/glassbox.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude-code-log",
    "secrets",
    "secret-scanning",
    "claude-md",
    "adherence",
    "compare",
    "live-tail",
    "claude",
    "agent",
    "agent-sdk",
    "trace",
    "jsonl",
    "viewer",
    "observability",
    "tokens",
    "cost",
    "accessibility"
  ],
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "homepage": "https://github.com/aldohushi1-stack/glassbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldohushi1-stack/glassbox.git"
  },
  "bugs": {
    "url": "https://github.com/aldohushi1-stack/glassbox/issues"
  }
}
